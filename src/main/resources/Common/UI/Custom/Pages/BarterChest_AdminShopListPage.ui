$C = "../Common.ui";

$C.@PageOverlay {
  $C.@Container {
    Anchor: (Width: 700, Height: 650);

    #Title {
      Group {
        $C.@Title {
          @Text = "Shop Admin List";
        }
      }
    }

    #Content {
      LayoutMode: Top;
      Padding: (Left: 20, Right: 20, Top: 10, Bottom: 10);

      Label #SummaryLabel {
        Text: "";
        Style: (
          FontSize: 13,
          TextColor: #96a9be,
          HorizontalAlignment: Center
        );
        Anchor: (Bottom: 10);
      }

      // Pagination controls (server sets PageLabel; buttons emit Action=page:prev/page:next)
      Group #Pager {
        LayoutMode: Left;
        Anchor: (Height: 34, Width: 660);
        Padding: (Bottom: 8);

        Button #PrevPageButton {
          Anchor: (Width: 120, Height: 30);
          Background: $C.@InputBoxBackground;
          Label { Text: "< Prev"; Style: (HorizontalAlignment: Center, VerticalAlignment: Center, TextColor: #FFFFFF); }
        }

        Label #PageLabel {
          Text: "";
          Style: (
            FontSize: 13,
            TextColor: #FFFFFF,
            HorizontalAlignment: Center,
            VerticalAlignment: Center
          );
          Anchor: (Width: 420, Height: 30);
        }

        Button #NextPageButton {
          Anchor: (Width: 120, Height: 30);
          Background: $C.@InputBoxBackground;
          Label { Text: "Next >"; Style: (HorizontalAlignment: Center, VerticalAlignment: Center, TextColor: #FFFFFF); }
        }
      }

      Group #ShopList {
        Anchor: (Width: 660);
        FlexWeight: 1;
        LayoutMode: TopScrolling;
        Padding: (Top: 6);
        ScrollbarStyle: $C.@DefaultScrollbarStyle;

        Group #Rows {
          LayoutMode: Top;

          // Rows are populated by the server. Each button emits an EventData action
          // of the form: teleport:<world>:<x>:<y>:<z>

          // 0
          Button #ShopRow0 {
            Anchor: (Width: 650, Height: 48);
            Background: $C.@InputBoxBackground;
            Padding: (Left: 10, Right: 10);
            Group {
              LayoutMode: Left;
              Anchor: (Width: 630, Height: 48);Label #LineA0 { Text: ""; Style: (FontSize: 15, TextColor: #FFFFFF); Anchor: (Left: 10, Top: 6); }
              Label #LineB0 { Text: ""; Style: (FontSize: 12, TextColor: #96a9be); Anchor: (Left: 10, Top: 26); }
            }
          }

          // 1
          Button #ShopRow1 {
            Anchor: (Width: 650, Height: 48, Top: 6);
            Background: $C.@InputBoxBackground;
            Padding: (Left: 10, Right: 10);
            Group {
              LayoutMode: Left;
              Anchor: (Width: 630, Height: 48);Label #LineA1 { Text: ""; Style: (FontSize: 15, TextColor: #FFFFFF); Anchor: (Left: 10, Top: 6); }
              Label #LineB1 { Text: ""; Style: (FontSize: 12, TextColor: #96a9be); Anchor: (Left: 10, Top: 26); }
            }
